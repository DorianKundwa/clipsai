# Keep the build context small and free of secrets/artifacts.

# VCS and environment
.git
.gitignore
.env
.env.*
!.env.example
.venv
venv
env

# Python caches
__pycache__
*.py[cod]
.pytest_cache
*.egg-info

# Generated / local data
outputs
data
test_files

# Not needed in the image
report
sandbox
tests
*.ipynb
*.log

# Sibling reference / tooling folders
openshorts
opensource-clipping
.freebuff
.claude
.agents

# Node build/cache directories (web uses its own stage build)
web/node_modules
web/build
web/.svelte-kit
web/static/ffmpeg
