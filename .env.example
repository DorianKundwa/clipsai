# ClipsAI Studio - backend configuration
#
# Copy to `.env` (gitignored) and fill in what you use:
#     cp .env.example .env
#
# Values in the real environment always win over this file.

# --- DeepSeek (AI clip finding, hooks, titles, effects, translation) ----------
# Create a key at https://platform.deepseek.com (Account -> API keys)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# --- HuggingFace / pyannote (speaker diarization for vertical reframing) -----
# https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=

# --- IndiePost (publishing to YouTube / TikTok / Instagram / Facebook) --------
# Create a key in IndiePost -> Settings -> API keys
INDIEPOST_API_KEY=
INDIEPOST_BASE_URL=https://www.indiepost.app

# --- Output storage (job folders under outputs/) -----------------------------
# Applied at startup and from the Storage page. Set a rule to 0 to disable it.
# Delete jobs older than this many days (default 30)
CLIPSAI_RETENTION_DAYS=30
# Always keep at least this many recent jobs (default 20)
CLIPSAI_KEEP_JOBS=20
# Optional cap on the total size of job folders, in GB (default 0 = no cap)
CLIPSAI_STORAGE_BUDGET_GB=0

# Folders whose sub-directories are listed as campaign workspaces alongside the
# pipeline jobs. `outputs` and `work` are always included; extra roots go here,
# comma separated (relative paths are resolved from the repository root).
CLIPSAI_WORKSPACE_DIRS=
